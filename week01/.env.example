# Αντιγράψτε σε .env και βάλτε το δικό σας κλειδί. Το .env ΔΕΝ ανεβαίνει ποτέ στο git.
# Βασικός πάροχος του μαθήματος: Anthropic (Claude). Τα άλλα κλειδιά είναι προαιρετικά.
# Το Gemini έχει δωρεάν επίπεδο, αλλά με πολύ χαμηλό ημερήσιο όριο.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Μοντέλα σε μορφή LiteLLM: <provider>/<όνομα μοντέλου>.
# Ελέγξτε τα ονόματα πριν το μάθημα: οι πάροχοι αλλάζουν συχνά μοντέλα.
MODEL=anthropic/claude-haiku-5-5
MODEL_LOCAL=ollama_chat/gemma3:4b
# Για το demo πιθανοτήτων χρειάζεται μοντέλο που επιστρέφει logprobs (π.χ. OpenAI).
MODEL_LOGPROBS=openai/gpt-4.1-mini
# Για το arena: λίστα μοντέλων χωρισμένων με κόμμα.
ARENA_MODELS=anthropic/claude-haiku-5-5,gemini/gemini-3.8-flash,ollama_chat/gemma3:4b

# Κατάλογος τιμών του LiteLLM: με False κατεβάζει τον πιο πρόσφατο από το internet σε κάθε εκκίνηση,
# ώστε να ξέρει και τις τιμές νέων μοντέλων (π.χ. claude-haiku-5-5). Αλλάξτε σε True μόνο αν
# χωρίς internet το πρόγραμμα αργεί πολύ να ξεκινήσει.
LITELLM_LOCAL_MODEL_COST_MAP=False
