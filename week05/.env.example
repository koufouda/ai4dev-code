# Εβδομάδα 5. Αν έχετε ήδη C:\ai4dev\.env από την εβδομάδα 1, ΔΕΝ χρειάζεστε νέο:
# τα scripts του φακέλου week05 το βρίσκουν μόνα τους στον γονικό φάκελο.
# Προσθέστε μόνο τη γραμμή MODEL_JUDGE στο υπάρχον .env.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
GEMINI_API_KEY=

# Βασικό μοντέλο
MODEL=anthropic/claude-haiku-5-5
# Τοπικό μοντέλο (Ollama)
MODEL_LOCAL=ollama_chat/gemma3:4b
# Το μοντέλο-κριτής του judge.py (διάλεξη 10). Καλύτερα διαφορετικό από το MODEL.
MODEL_JUDGE=anthropic/claude-haiku-5-5

LITELLM_LOCAL_MODEL_COST_MAP=False
