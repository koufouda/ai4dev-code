# Εβδομάδα 7. Αν έχετε ήδη C:\ai4dev\.env, ΔΕΝ χρειάζεστε νέο:
# τα scripts του φακέλου week07 το βρίσκουν μόνα τους στον γονικό φάκελο.
# Αν προσθέσατε το EMBED_MODEL στην εβδομάδα 6, δεν χρειάζεται καμία αλλαγή.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
GEMINI_API_KEY=

# Βασικό μοντέλο
MODEL=anthropic/claude-haiku-5-5
# Τοπικό μοντέλο (Ollama)
MODEL_LOCAL=ollama_chat/gemma3:4b
# Μοντέλο-κριτής (εβδομάδα 5)
MODEL_JUDGE=anthropic/claude-haiku-5-5
# Μοντέλο embeddings (εβδομάδα 6). Τοπικό και δωρεάν: πρώτα  ollama pull embeddinggemma
EMBED_MODEL=ollama/embeddinggemma
# Εναλλακτικές με κλειδί: openai/text-embedding-3-small  ή  gemini/gemini-embedding-001

LITELLM_LOCAL_MODEL_COST_MAP=False
