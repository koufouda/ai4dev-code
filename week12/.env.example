# Εβδομάδα 12. Αν έχετε ήδη C:\ai4dev\.env, ΔΕΝ χρειάζεστε νέο:
# τα scripts του φακέλου week12 το βρίσκουν μόνα τους στον γονικό φάκελο.
# Αν προσθέσατε το EMBED_MODEL στην εβδομάδα 6, δεν χρειάζεται καμία αλλαγή.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
GEMINI_API_KEY=

# Βασικό μοντέλο
MODEL=anthropic/claude-haiku-5-5
# Τοπικό μοντέλο (Ollama)
MODEL_LOCAL=ollama_chat/gemma3:4b
# Μοντέλο-κριτής (εβδομάδα 5)
MODEL_JUDGE=anthropic/claude-haiku-5-5
# Μοντέλο embeddings (εβδομάδα 6). Τοπικό και δωρεάν: πρώτα  ollama pull embeddinggemma
EMBED_MODEL=ollama/embeddinggemma
# Εναλλακτικές με κλειδί: openai/text-embedding-3-small  ή  gemini/gemini-embedding-001

LITELLM_LOCAL_MODEL_COST_MAP=False

# ---- Νέα στην εβδομάδα 11 (προαιρετικά στο laptop, απαραίτητα στο container) ----
# Τυχαίο κείμενο για την ψευδωνυμοποίηση των χρηστών στα logs (διάλεξη 22). Π.χ.:  python -c "import secrets; print(secrets.token_hex(16))"
PSEUDO_SALT=
# Πού είναι το Ollama. Μέσα από Docker: http://host.docker.internal:11434
# OLLAMA_API_BASE=http://host.docker.internal:11434
